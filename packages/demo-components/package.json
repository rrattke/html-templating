{
  "name": "@demo/components",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./counter": {
      "import": "./lib/counter.js",
      "types": "./lib/counter.d.ts"
    },
    "./list": {
      "import": "./lib/list.js",
      "types": "./lib/list.d.ts"
    },
    "./todo-list": {
      "import": "./lib/todo-list.js",
      "types": "./lib/todo-list.d.ts"
    },
    "./data-table": {
      "import": "./lib/data-table.js",
      "types": "./lib/data-table.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "format": "dprint fmt \"**/*\"",
    "format:check": "dprint check \"**/*\"",
    "lint": "run-p lint:js lint:md",
    "lint:check": "run-p lint:js:check lint:md:check",
    "lint:js": "eslint . --fix",
    "lint:js:check": "eslint . --max-warnings=0",
    "lint:md": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:md:check": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc \"**/*.md\""
  },
  "dependencies": {
    "@vanishing/framework": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "dprint": "^0.54.0",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all2": "^9.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.14.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
