{
  "name": "@vanishing/framework",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./reactive": {
      "import": "./lib/reactive.js",
      "types": "./lib/reactive.d.ts"
    },
    "./runtime": {
      "import": "./lib/runtime.js",
      "types": "./lib/runtime.d.ts"
    },
    "./template": {
      "import": "./lib/template.js",
      "types": "./lib/template.d.ts"
    },
    "./wc": {
      "import": "./lib/wc.js",
      "types": "./lib/wc.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "format": "dprint fmt \"**/*\"",
    "format:check": "dprint check \"**/*\"",
    "lint": "run-p lint:js lint:md",
    "lint:check": "run-p lint:js:check lint:md:check",
    "lint:js": "eslint . --fix",
    "lint:js:check": "eslint . --max-warnings=0",
    "lint:md": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:md:check": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc \"**/*.md\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "dprint": "^0.54.0",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all2": "^9.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.14.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
