{
  "name": "html-templating-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build:lib:framework": "pnpm --filter @vanishing/framework run build",
    "build:lib:demo-components": "pnpm --filter @demo/components run build",
    "build:lib": "run-s build:lib:framework build:lib:demo-components",
    "build:app:native": "pnpm --filter native-signals-example run build",
    "build:app:solid": "pnpm --filter solid-signals-example run build",
    "build:app:static": "pnpm --filter static-example run build",
    "build:app": "run-p build:app:native build:app:solid build:app:static",
    "build": "pnpm -r run build",
    "dev:lib:framework": "pnpm --filter @vanishing/framework run dev",
    "dev:lib:demo-components": "pnpm --filter @demo/components run dev",
    "dev:app:native": "pnpm --filter native-signals-example run dev",
    "dev:app:solid": "pnpm --filter solid-signals-example run dev",
    "dev:app:static": "pnpm --filter static-example run dev",
    "dev": "run-p dev:lib:framework dev:lib:demo-components dev:app:native",
    "dev:solid": "run-p dev:lib:framework dev:lib:demo-components dev:app:solid",
    "dev:static": "run-p dev:lib:framework dev:app:static",
    "start": "run-s build:lib build:app:native && pnpm --filter native-signals-example run preview",
    "start:solid": "run-s build:lib build:app:solid && pnpm --filter solid-signals-example run preview",
    "start:static": "run-s build:lib:framework build:app:static && pnpm --filter static-example run preview",
    "test": "pnpm -r --if-present --parallel run test",
    "clean": "pnpm -r --if-present --parallel run clean",
    "lint": "pnpm -r --if-present --parallel run lint",
    "lint:check": "pnpm -r --if-present --parallel run lint:check",
    "format": "pnpm -r --if-present --parallel run format",
    "format:check": "pnpm -r --if-present --parallel run format:check",
    "check": "run-s format:check lint:check test"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.1"
  }
}
