{
  "name": "html-templating-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:native": "npm run dev --workspace=native-signals-example",
    "dev:solid": "npm run dev --workspace=solid-signals-example",
    "start": "npm run dev --workspace=native-signals-example"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
