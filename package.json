{
  "name": "html-templating-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:lib:framework": "npm run build -w @vanishing/framework",
    "build:lib:demo-components": "npm run build -w @demo/components",
    "build:lib": "run-s build:lib:framework build:lib:demo-components",
    "build:app:native": "npm run build -w native-signals-example",
    "build:app:solid": "npm run build -w solid-signals-example",
    "build:app:static": "npm run build -w static-example",
    "build:app": "run-s build:app:native build:app:solid build:app:static",
    "build": "run-s build:lib build:app",
    "dev:lib:framework": "npm run dev -w @vanishing/framework",
    "dev:lib:demo-components": "npm run dev -w @demo/components",
    "dev:app:native": "npm run dev -w native-signals-example",
    "dev:app:solid": "npm run dev -w solid-signals-example",
    "dev:app:static": "npm run dev -w static-example",
    "dev": "run-p dev:lib:framework dev:lib:demo-components dev:app:native",
    "dev:solid": "run-p dev:lib:framework dev:lib:demo-components dev:app:solid",
    "dev:static": "run-p dev:lib:framework dev:app:static",
    "start": "run-s build:lib build:app:native && npm run preview -w native-signals-example",
    "start:solid": "run-s build:lib build:app:solid && npm run preview -w solid-signals-example",
    "start:static": "run-s build:lib:framework build:app:static && npm run preview -w static-example",
    "test": "npm test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "run-s format:check lint:check test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "dprint": "^0.54.0",
    "eslint": "^10.3.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jiti": "^2.6.1",
    "npm-run-all2": "^7.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.0"
  }
}
