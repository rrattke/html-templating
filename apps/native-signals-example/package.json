{
  "name": "native-signals-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview",
    "clean": "rm -rf bin",
    "format": "dprint fmt \"**/*\"",
    "format:check": "dprint check \"**/*\"",
    "lint": "run-p lint:js lint:md",
    "lint:check": "run-p lint:js:check lint:md:check",
    "lint:js": "eslint . --fix",
    "lint:js:check": "eslint . --max-warnings=0",
    "lint:md": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:md:check": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc \"**/*.md\""
  },
  "dependencies": {
    "@demo/components": "workspace:*",
    "@vanishing/framework": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dprint": "^0.54.0",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all2": "^9.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14"
  }
}
